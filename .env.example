# ── Database (Drizzle) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ── Supabase self-hosted config ──
POSTGRES_PASSWORD=postgres
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# 🔐 Contraseñas separadas para usuarios internos de la BD
# La imagen supabase/postgres crea supabase_auth_admin y supabase_storage_admin
# usando estos valores. Si los cambiás post-deploy, tenés que actualizar las
# credenciales manualmente en la BD.
AUTH_DB_PASSWORD=cambiar_para_auth
STORAGE_DB_PASSWORD=cambiar_para_storage

# 🔐 Clave secreta para Realtime (generar con: openssl rand -base64 64)
REALTIME_SECRET_KEY_BASE=generar_con_openssl_rand_base64_64

# ── Google OAuth ──
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Resend (transactional email) ──
RESEND_API_KEY=

# ── Polar (payments) ──
POLAR_WEBHOOK_SECRET=

# ── Sentry ──
VITE_SENTRY_DSN=

# ── PostHog ──
VITE_POSTHOG_KEY=

# ── Google Analytics ──
VITE_GA_MEASUREMENT_ID=
